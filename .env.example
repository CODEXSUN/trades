# â”€â”€ Runtime â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NODE_ENV=development
PLATFORM_API_PORT=7070
PLATFORM_WEB_PORT=7080
PLATFORM_WEB_ORIGIN=http://app.trades.test
PLATFORM_WEB_ORIGINS=http://127.0.0.1:7080,http://localhost:7080
PLATFORM_WEB_HEALTH_URL=
PLATFORM_API_URL=http://127.0.0.1:7070

# â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
TRADES_DB_NAME=trades_db
# Core compatibility guard only. Trades never creates or connects to this database.
DB_MASTER_NAME=__trades_core_guard_unused__

# Database lifecycle.
# TRADES_DB_FRESH_ON_START=1 drops and rebuilds the Trades database on API startup.
# Destructive actions require TRADES_DB_RESET_CONFIRM=DROP_DATABASES.
# Production additionally requires TRADES_ALLOW_PRODUCTION_DB_RESET=1.
TRADES_DB_FRESH_ON_START=0
TRADES_DB_RESET_CONFIRM=
TRADES_ALLOW_PRODUCTION_DB_RESET=0

# Database maintenance and queue-backed backup/restore.
TRADES_BACKUP_DIR=storage/backups/database
TRADES_RESTORE_TEST_DB_NAME=
TRADES_VERIFIED_BACKUP_ID=
TRADES_ALLOW_LIVE_RESTORE=0
TRADES_LIVE_RESTORE_CONFIRM=

# Runtime storage roots. The fixed client root is derived beneath these locations.
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public

# Queue backend. Use database locally; BullMQ/Redis is reserved for cloud scale.
TRADES_QUEUE_BACKEND=database
TRADES_REDIS_URL=redis://127.0.0.1:6379

TRADES_QUEUE_WORKER_ENABLED=1
TRADES_QUEUE_WORKER_INTERVAL_MS=5000
TRADES_QUEUE_COMPLETED_RETENTION_DAYS=14
TRADES_QUEUE_FAILED_RETENTION_DAYS=30

# Required single-client bootstrap.
ENABLE_SINGLE_CLIENT=1
DEV_AUTO_CLIENT_LOGIN=0
CLIENT_DOMAIN_BASE=localhost
CLIENT_NAME=Trades
CLIENT_CORPORATE_ID=TRADES
CLIENT_SLUG=trades
CLIENT_DOMAIN=app.trades.test
CLIENT_ADMIN_NAME=
CLIENT_ADMIN_EMAIL=
CLIENT_ADMIN_PASSWORD=

# â”€â”€ Auth â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# REQUIRED. No fallback.
JWT_SECRET=

# Auth mode: "jwt" (default, bearer token), "cookie" (web sessions), or "hybrid" (both).
AUTH_MODE=jwt

# â”€â”€ Seed users (blank on live deployments) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Optional first platform users. Leave blank on live and create users
# manually unless this deployment intentionally needs a seeded account.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

# Credentials for the one Trades client administrator are defined above.

# â”€â”€ Dev / Tooling â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Set to "abort" to prevent the dev preflight from killing active listeners.
# TRADES_DEV_PORT_POLICY=abort

# Optional database-user helper overrides. Keep passwords only in local .env.
DB_ADMIN_PASSWORD=
# MARIADB_CLIENT=C:\Program Files\MariaDB 12.3\bin\mariadb.exe

# Set to 1 for faster local restarts when the database is already prepared.
# Skips the API database preflight and startup database bootstrap.
TRADES_DEV_SKIP_DB=0

# Database safety command guards.
# Required for npm run db:migrations:test-local after restoring a dump locally.
TRADES_RESTORED_DUMP_TEST=0

# Required for npm run db:backup:verify.
TRADES_BACKUP_VERIFY_ID=
