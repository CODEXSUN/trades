NODE_ENV=production
TRADES_VERSION=1.0.2
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
TRADES_IMAGE_REGISTRY=trades
TRADES_BIND_ADDRESS=127.0.0.1
CODEXSUN_BACKEND_NETWORK=cxapp-network
CODEXSUN_EDGE_NETWORK=cxapp-edge
MARIADB_CONTAINER_NAME=cxapp-mariadb
REDIS_CONTAINER_NAME=cxapp-redis
MEDIA_CONTAINER_NAME=cxapp-media
TRADES_WEB_HOST=trades.codexsun.com

PLATFORM_API_PORT=7070
PLATFORM_WEB_PORT=7080
PLATFORM_API_HOST_PORT=18070
PLATFORM_WEB_HOST_PORT=18080
PLATFORM_API_URL=http://trades-api:7070
PLATFORM_WEB_ORIGIN=https://trades.codexsun.com
PLATFORM_WEB_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
PLATFORM_WEB_HEALTH_URL=http://trades-web:80

DB_DRIVER=mariadb
DB_HOST=cxapp-mariadb
DB_PORT=3306
DB_USER=cxapp_app
DB_PASSWORD=inherited_from_cxapp
TRADES_DB_NAME=trades_db
# Core compatibility guard only. No database is created with this name.
DB_MASTER_NAME=__trades_core_guard_unused__

TRADES_REDIS_USER=default
TRADES_REDIS_PASSWORD=inherited_from_cxapp
TRADES_QUEUE_BACKEND=bullmq-redis
TRADES_REDIS_URL=redis://default:inherited_from_cxapp@cxapp-redis:6379/1
TRADES_QUEUE_WORKER_ENABLED=1
TRADES_QUEUE_WORKER_INTERVAL_MS=5000
TRADES_QUEUE_COMPLETED_RETENTION_DAYS=14
TRADES_QUEUE_FAILED_RETENTION_DAYS=30

TRADES_API_IMAGE_TAG=1.0.2
TRADES_WEB_IMAGE_TAG=1.0.2
TRADES_MIGRATIONS_IMAGE_TAG=1.0.2
TRADES_DATA_VOLUME=trades-platform-data
STORAGE_ROOT=/storage/app
STORAGE_PUBLIC_ROOT=/storage/public

JWT_SECRET=change_this_trades_jwt_secret
AUTH_MODE=jwt
SUPER_ADMIN_NAME=Trades Super Admin
SUPER_ADMIN_EMAIL=admin@trades.in
SUPER_ADMIN_PASSWORD=change_this_trades_super_admin_password
SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=
CLIENT_ADMIN_NAME=Trades Administrator
CLIENT_ADMIN_EMAIL=admin@trades.in
CLIENT_ADMIN_PASSWORD=change_this_trades_client_admin_password

ENABLE_SINGLE_CLIENT=1
CLIENT_CORPORATE_ID=TRADES
CLIENT_DOMAIN=trades.codexsun.com
CLIENT_NAME=Trades
CLIENT_SLUG=trades
CLIENT_DOMAIN_BASE=codexsun.com
DEV_AUTO_CLIENT_LOGIN=0

TRADES_DB_FRESH_ON_START=0
TRADES_DB_RESET_CONFIRM=
TRADES_ALLOW_PRODUCTION_DB_RESET=0
TRADES_VERIFIED_BACKUP_ID=initial-empty-database
TRADES_BACKUP_DIR=/storage/backups/database
TRADES_RESTORE_TEST_DB_NAME=
TRADES_ALLOW_LIVE_RESTORE=0
TRADES_LIVE_RESTORE_CONFIRM=
