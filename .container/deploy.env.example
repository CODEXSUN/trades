# Docker project and images
TRADES_COMPOSE_PROJECT=trades
TRADES_IMAGE_REGISTRY=trades
TRADES_IMAGE_TAG=local
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
TRADES_BACKUP_RETENTION=10

# Docker resources
TRADES_API_CONTAINER_NAME=trades-api
TRADES_WEB_CONTAINER_NAME=trades-web
TRADES_MARIADB_CONTAINER_NAME=trades-mariadb
TRADES_NETWORK=cxapp-network
TRADES_NETWORK_EXTERNAL=true
TRADES_MARIADB_DATA_VOLUME=trades-mariadb-data

# Loopback publishing
TRADES_BIND_ADDRESS=127.0.0.1
TRADES_API_INTERNAL_PORT=7050
TRADES_API_HOST_PORT=7050
TRADES_WEB_HOST_PORT=7060

# Standalone MariaDB infrastructure
MARIADB_IMAGE=mariadb:11.8
MARIADB_ROOT_PASSWORD=generate-with-setup
DB_USER=cxapp
DB_PASSWORD=generate-with-setup
DB_NAME=trades_db

# Reuse CXApp-owned MariaDB infrastructure while keeping the Trades database separate.
TRADES_SHARED_MARIADB_CONTAINER_NAME=cxapp-mariadb
TRADES_SHARED_MARIADB_ENV_FILE=../../cxapp/.container/deploy.env
TRADES_SHARED_MARIADB_ROOT_PASSWORD=
