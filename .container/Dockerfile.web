ARG NODE_RUNTIME_VERSION=26.5.0
FROM node:${NODE_RUNTIME_VERSION}-bookworm-slim AS build
ARG NPM_RUNTIME_VERSION=12.0.1
ARG CLIENT_NAME=Trades
ENV CLIENT_NAME=$CLIENT_NAME
ENV NODE_ENV=development
WORKDIR /workspace
RUN npm install --global npm@${NPM_RUNTIME_VERSION}
COPY framework ./framework
COPY core ./core
COPY ui ./ui
COPY trades ./trades
WORKDIR /workspace/trades
RUN npm ci && npm run setup
ENV NODE_ENV=production
RUN npm run build --prefix ../framework \
  && npm run build --workspace @trades/platform-web \
  && npm run dependencies:check

FROM nginx:1.28-alpine AS runtime
ARG TRADES_VERSION=1.0.2
LABEL org.opencontainers.image.title="Trades Platform Web" org.opencontainers.image.version="$TRADES_VERSION"
COPY trades/.container/scripts/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/trades/dist/platform/web /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
