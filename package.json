{
  "name": "@codexsun/trades",
  "version": "1.0.9",
  "private": false,
  "packageManager": "npm@12.0.1",
  "description": "CODEXSUN Trades pluggable CXApp business stack",
  "type": "module",
  "files": [
    "src/web/src",
    "dist/api",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/api/stack.d.ts",
      "default": "./dist/api/stack.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./host": {
      "types": "./dist/api/app.d.ts",
      "default": "./dist/api/app.js"
    },
    "./database": {
      "types": "./dist/api/database/index.d.ts",
      "default": "./dist/api/database/index.js"
    },
    "./stack": {
      "types": "./dist/api/stack.d.ts",
      "default": "./dist/api/stack.js"
    },
    "./web": "./src/web/src/index.ts",
    "./web/cxapp": "./src/web/src/cxapp.tsx"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.api.json",
    "typecheck": "tsc -p tsconfig.api.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src tools --ext .ts,.tsx,.mjs",
    "check": "npm run format:check && npm run check:table-prefixes && npm run lint && npm run typecheck && npm run build",
    "check:table-prefixes": "node tools/check-table-prefixes.mjs",
    "version:bump": "node tools/version-bump.mjs",
    "version-bump": "node tools/version-bump.mjs",
    "github:now": "node tools/github-now.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "fastify": "^5.2.1",
    "kysely": "^0.29.0",
    "lucide-react": "^1.22.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@codexsun/framework": ">=1.0.47",
    "@codexsun/ui": ">=1.0.48",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@codexsun/framework": "file:../framework",
    "@codexsun/ui": "file:../ui",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^10.8.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint-compiler": "npm:typescript@6.0.3"
  },
  "engines": {
    "node": ">=26.5.0",
    "npm": ">=12.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
